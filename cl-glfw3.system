(in-package "CL-USER")

(defvar *cl-glfw3-source-dir*
  (merge-pathnames "Github/cl-glfw3/" (translate-logical-pathname "EXTERN:")))
(defvar *cl-glfw3-binary-dir* (binary-directory *cl-glfw3-source-dir*))

(mk:defsystem :cl-glfw3
  :source-pathname *cl-glfw3-source-dir*
  :binary-pathname *cl-glfw3-binary-dir*
  :source-extension "lisp"
  :depends-on (#:cffi #:alexandria)
  :components ((:file "package")
               (:file "glfw-bindings")
               (:file "cl-glfw3")))

#+nil
(mk:oos :cl-glfw3 :load :compile-during-load t)

(mk:defsystem :cl-glfw3-examples
  :source-pathname *cl-glfw3-source-dir*
  :binary-pathname *cl-glfw3-binary-dir*
  :source-extension "lisp"
  :depends-on (#:cl-glfw3 #:cl-opengl #:trivial-main-thread)
  :components
  ((:module
    "examples"
    :components ((:file "package")
		 (:file "basic-window")
		 (:file "fragment-shader")
		 (:file "particles-basic")
		 (:file "events")))))


#+nil
(mk:oos :cl-glfw3-examples :load :compile-during-load t)
